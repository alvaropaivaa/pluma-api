DATABASE_URL=postgres://localhost:5432/whatsapp_api
PORT=8080
HOST=0.0.0.0
# chave de administrador (cria contas). Gere com: openssl rand -hex 32
ADMIN_KEY=
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
# intervalo mínimo entre envios do mesmo número (ms). Um atraso aleatório de até 50% é somado
SEND_MIN_INTERVAL_MS=1200
# por quantos dias guardar mensagens (usadas para reenvio quando a outra ponta não descriptografa)
MESSAGE_RETENTION_DAYS=7

# URL pública da API (links de mídia quando MEDIA_STORAGE=local)
PUBLIC_URL=http://localhost:8080

# Limites de envio por número
SEND_MAX_PER_MINUTE=20
SEND_MAX_PER_DAY=1000
# 0 = sem aquecimento; N = limite diário começa em 20% e chega a 100% em N dias (use 7 para chip novo)
SEND_WARMUP_DAYS=0
# quanto o POST de envio espera o resultado antes de devolver 202 (fila)
SEND_WAIT_MS=25000

# Mídia: local (pasta no servidor) ou s3 (Cloudflare R2, Supabase Storage, AWS...)
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./data/media
MEDIA_MAX_MB=64
MEDIA_URL_TTL_DAYS=7
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# se o bucket for público, links diretos em vez de assinados
S3_PUBLIC_BASE_URL=

# Só para desenvolvimento local: permite URLs de localhost/rede interna (NUNCA em produção)
ALLOW_PRIVATE_URLS=false

# Portas públicas do Caddy. Mude se outro sistema já usa 80/443 neste servidor
HTTP_PORT=80
HTTPS_PORT=443

# Alertas por e-mail: Resend ou SMTP, mais o remetente. Sem ALERT_FROM nenhum e-mail sai
# Exemplo de remetente: API Roxa <alertas@seudominio.com.br> (o domínio precisa estar autorizado no provedor)
RESEND_API_KEY=
SMTP_URL=
ALERT_FROM=

# Marca do painel e da documentação
BRAND_NAME=API Roxa
BRAND_COLOR=#7C2D92
BRAND_LOGO=/painel/brand/api-roxa-mark.png
